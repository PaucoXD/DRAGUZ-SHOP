rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = existe un documento admins/{uid} (se crea a mano en la consola de Firebase)
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Contenido público: lo lee cualquiera, solo el admin lo modifica
    match /catalog/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /stock/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /extras/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Cada usuario solo puede saber si él mismo es admin; nadie escribe desde la web
    match /admins/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }

    // Cotizaciones: el usuario crea y lee las suyas; el admin lee y gestiona todas.
    // Sin cuenta también se puede enviar una solicitud (con nombre y WhatsApp), pero no leerla.
    function isGuestQuote(d) {
      return d.uid == null && d.guest == true && d.status == 'nueva' &&
             d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() <= 80 &&
             d.customer.phone is string && d.customer.phone.size() >= 10 && d.customer.phone.size() <= 20 &&
             d.lines is list && d.lines.size() > 0 && d.lines.size() <= 50;
    }
    match /quotes/{id} {
      allow create: if (request.auth != null && request.resource.data.uid == request.auth.uid) ||
                       isGuestQuote(request.resource.data);
      allow read:   if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
