rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = existe un documento admins/{uid} (se crea a mano en la consola de Firebase)
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Contenido público: lo lee cualquiera, solo el admin lo modifica
    match /catalog/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /stock/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /extras/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{id}         { allow read: if true; allow write: if isAdmin(); }

    // Cada usuario solo puede saber si él mismo es admin; nadie escribe desde la web
    match /admins/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }

    // Cotizaciones: el usuario crea y lee las suyas; el admin lee y gestiona todas.
    // Sin cuenta también se puede enviar una solicitud (con nombre y WhatsApp), pero no leerla.
    function isGuestQuote(d) {
      return d.uid == null && d.guest == true && d.status == 'nueva' &&
             d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() <= 80 &&
             d.customer.phone is string && d.customer.phone.size() >= 10 && d.customer.phone.size() <= 20 &&
             d.lines is list && d.lines.size() > 0 && d.lines.size() <= 50;
    }
    match /quotes/{id} {
      allow create: if (request.auth != null && request.resource.data.uid == request.auth.uid) ||
                       isGuestQuote(request.resource.data);
      allow read:   if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Tarjetas de cliente: el código impreso funciona como llave.
    // Cualquiera puede consultar UNA tarjeta por su código, pero no listarlas.
    // Una tarjeta libre la puede activar su dueño una sola vez (solo nombre y WhatsApp).
    match /cards/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.status == 'libre' &&
        request.resource.data.status == 'activa' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'name', 'phone', 'activatedAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.activatedAt is number
      );
    }

    // Compras registradas, sorteos e inventario de prendas lisas: solo el admin
    // Seguimiento público por folio: datos mínimos (sin nombre ni teléfono).
    // El cliente lo crea al enviar su solicitud; solo el admin lo actualiza.
    match /tracking/{folio} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['folio', 'status', 'total', 'anticipo', 'items', 'createdAt', 'updatedAt']) &&
        request.resource.data.folio == folio && request.resource.data.status == 'nueva' &&
        request.resource.data.total is number && request.resource.data.items is list && request.resource.data.items.size() <= 50
      );
    }

    match /purchases/{id} { allow read, write: if isAdmin(); }
    match /raffles/{id}   { allow read, write: if isAdmin(); }
    match /blanks/{id}    { allow read, write: if isAdmin(); }
  }
}
